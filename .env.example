# Database Configuration
POSTGRES_HOST=your-database-host
POSTGRES_PORT=5432
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=your-database-name
POSTGRES_SCHEMA=lad_dev
POSTGRES_MAX_CLIENTS=10
POSTGRES_IDLE_TIMEOUT=30000

# Server Configuration
PORT=3004
NODE_ENV=development

# Apollo.io Configuration (for lead generation)
APOLLO_API_KEY=your-apollo-api-key
# Set to true if your Apollo API key doesn't have access to people search endpoints
APOLLO_SKIP_PEOPLE_SEARCH=false

# OpenAI Configuration (for industry keyword expansion and enhanced chat)
OPENAI_API_KEY=your-openai-api-key

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
BACKEND_URL=http://localhost:3004

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
