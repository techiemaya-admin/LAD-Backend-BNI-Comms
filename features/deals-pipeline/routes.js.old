// Add note to lead
router.post('/:id/notes', jwtAuth, async (req, res) => {
  try {
    const { content } = req.body;
    if (!content || !content.trim()) {
      return res.status(400).json({ error: 'Note content is required' });
    }
    
    console.log('Adding note with user info:', {
      userId: req.user?.userId,
      email: req.user?.email,
      name: req.user?.name,
      userObject: req.user
    });
    
    const note = await Lead.addLeadNote(
      req.params.id, 
      content.trim(),
      req.user?.userId,
      req.user?.name || req.user?.email, // Use email as fallback for name
      req.user?.avatar
    );
    res.status(201).json(note);
  } catch (err) {
    console.error('Failed to add note:', err);
    res.status(500).json({ error: 'Failed to add note', details: err.message });
  }
});

// Delete note
router.delete('/:id/notes/:noteId', jwtAuth, async (req, res) => {
  try {
    await Lead.deleteLeadNote(req.params.noteId);
    res.json({ message: 'Note deleted successfully' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete note', details: err.message });
  }
});

