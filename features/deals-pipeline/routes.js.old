// Get all lead stages (pipeline columns)
router.get('/stages', jwtAuth, async (req, res) => {
  try {
    console.log('[LEADS API] Getting stages for user:', req.user?.userId);
    const stages = await LeadStage.getAllLeadStages();
    console.log('[LEADS API] Stages retrieved successfully:', stages.length, 'stages');
    res.json(stages);
  } catch (err) {
    console.error('[LEADS API] Error getting stages:', err);
    res.status(500).json({ error: 'Server error', details: err.message });
