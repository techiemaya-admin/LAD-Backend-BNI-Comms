// GET /api/leads/pipeline/board - Complete pipeline board data
router.get('/pipeline/board', jwtAuth, async (req, res) => {
  try {
    const [stages, leads] = await Promise.all([
      LeadStage.getAllLeadStages(),
      Lead.listLeads()
    ]);

    // Group leads by stage
    const leadsByStage = leads.reduce((acc, lead) => {
      const stageKey = lead.stage || 'unassigned';
      if (!acc[stageKey]) acc[stageKey] = [];
      acc[stageKey].push(lead);
      return acc;
    }, {});

    res.json({
      stages: stages || [],
      leads: leads || [],
      leadsByStage
    });
  } catch (err) {
    console.error('[LEADS API] Error getting pipeline board:', err);
    res.status(500).json({ error: 'Failed to fetch pipeline board', details: err.message });
  }
});

// Get all leads with optional filtering
router.get('/', jwtAuth, async (req, res) => {
  try {
    // For now, pass null to get all leads regardless of organization
    let leads = await Lead.getAllLeads(null, req.query);
    // Convert stage to lowercase if present
    leads = leads.map(lead => {
      if (lead.stage && typeof lead.stage === 'string') {
        return { ...lead, stage: lead.stage.toLowerCase() };
      }
      return lead;
    });
    res.json(leads);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch leads', details: err.message });
  }
});

