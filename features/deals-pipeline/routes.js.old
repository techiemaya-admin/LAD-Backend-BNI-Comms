router.get('/:id', jwtAuth, async (req, res) => {
  try {
    const lead = await Lead.getLeadById(req.params.id);
    if (!lead) {
      return res.status(404).json({ error: 'Lead not found' });
    }

    // Rename `channel` → `source`
    const transformedLead = {
      ...lead,
      source: lead.channel,   // add new key
    };
    delete transformedLead.channel; // remove old key

    res.json(transformedLead);
  } catch (err) {
    res.status(500).json({ error: 'Failed to fetch lead', details: err.message });
  }
});


// Create new lead
router.post('/', jwtAuth, async (req, res) => {
  try {
    // Extract tags from the request body (same as update route)
    const { tags, ...frontendData } = req.body;
    
    // Map frontend field names to database column names
    const fieldMapping = {
      dueDate: 'due_date',
      closeDate: 'close_date',
      lastActivity: 'last_activity',
      jobTitle: 'job_title',
      leadType: 'lead_type',
      assignedTo: 'assigned_to_id',
      createdBy: 'created_by_id',
      ownerId: 'owner_id',
      isArchived: 'is_archived',
      isDeleted: 'is_deleted',
      dealRecommendation: 'deal_recommendation',
      engagementLabel: 'engagement_label',
      engagementComparison: 'engagement_comparison',
      lastMessage: 'last_message'
    };
    
    // Convert frontend field names to database column names
    const leadData = {};
    Object.entries(frontendData).forEach(([key, value]) => {
      const dbColumn = fieldMapping[key] || key;
      leadData[dbColumn] = value;
    });
    
    // Add organization_id to lead data
    leadData.organization_id = req.user?.organization_id;
    
    // Create the lead (excluding tags)
    const lead = await Lead.createLead(leadData);
    
    // Handle tags separately if provided
    if (tags && Array.isArray(tags) && tags.length > 0) {
      // TODO: Add tags when LeadTags model is created
      // for (const tag of tags) {
      //   await LeadTags.addTagToLead(lead.id, tag);
      // }
      console.warn('[Deals-Pipeline] Tag support not yet implemented');
    }
    
    res.status(201).json(lead);
  } catch (err) {
    console.error('[LEADS API] Error creating lead:', err);
    res.status(500).json({ error: 'Failed to create lead', details: err.message });
  }
});

// Update lead
router.put('/:id', jwtAuth, async (req, res) => {
  try {
    console.log('[LEADS API] Updating lead:', req.params.id, 'with data:', req.body);
    
    // Extract tags from the request body
    const { tags, ...leadUpdates } = req.body;
    
    // Update the lead (excluding tags)
    const lead = await Lead.updateLead(req.params.id, leadUpdates);
    
    // Handle tags separately if provided
    if (tags !== undefined) {
      // Get current tags
      const currentTags = await Lead.getLeadTags(req.params.id);
      
      // Remove tags that are no longer in the new tags array
      for (const currentTag of currentTags) {
        if (!tags.includes(currentTag)) {
          await Lead.removeLeadTag(req.params.id, currentTag);
        }
      }
      
      // Add new tags that weren't previously present
      for (const newTag of tags) {
        if (!currentTags.includes(newTag) && newTag.trim() !== '') {
          await Lead.addLeadTag(req.params.id, newTag);
        }
      }
    }
    
    console.log('[LEADS API] Lead updated successfully:', lead);
    res.json(lead);
  } catch (err) {
    console.error('[LEADS API] Error updating lead:', err);
    res.status(500).json({ error: 'Failed to update lead', details: err.message });
  }
});

// Delete lead
router.delete('/:id', jwtAuth, async (req, res) => {
  try {
    await Lead.deleteLead(req.params.id);
    res.json({ message: 'Lead deleted successfully' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete lead', details: err.message });
  }
});

// Update lead stage
router.put('/:id/stage', jwtAuth, async (req, res) => {
  try {
    const { id } = req.params;
    const { stage } = req.body;
    // const pool = require('../config/postgres');

    // Validate stage against DB
    const { rows: stageRows } = await pool.query('SELECT key FROM lead_stages WHERE key = $1', [stage]);
    if (!stageRows.length) {
      return res.status(400).json({ error: 'Invalid stage', details: `Stage '${stage}' does not exist.` });
    }

    // Status mapping for pipeline stages
    const STAGE_STATUS_MAP = {
      'new': 'active',
      'contact made': 'active',
      'trial session booked': 'active',
      'trial completed': 'active',
      'won': 'won',
      'abandoned': 'lost'
    };
    const status = STAGE_STATUS_MAP[stage] || 'active';

    const updatedLead = await Lead.updateLead(id, {
      stage,
      status,
      last_activity: new Date()
    });
    res.json(updatedLead);
  } catch (err) {
    res.status(500).json({ error: 'Failed to update lead stage', details: err.message });
  }
});

// ========================
// STAGE MANAGEMENT
// ========================

// Create new stage
router.post('/stages', jwtAuth, async (req, res) => {
  try {
    const { key, label, displayOrder } = req.body;
    console.log('[CREATE STAGE] Received data:', { key, label, displayOrder });
    const organizationId = req.user?.organization_id;
    
    const existingStages = await LeadStage.getAllLeadStages(organizationId);
    console.log('[CREATE STAGE] Existing stages:', existingStages.map(s => ({ key: s.key, label: s.label, order: s.display_order })));
    
    const stageExists = existingStages.some(stage => stage.key === key);
    
    if (stageExists) {
      return res.status(400).json({ error: 'Stage with this key already exists' });
    }

    const newStage = await LeadStage.createLeadStage(key, label, organizationId, displayOrder);
    res.status(201).json(newStage);
  } catch (err) {
    res.status(500).json({ error: 'Failed to create stage', details: err.message });
  }
});

// Update stage
router.put('/stages/:key', jwtAuth, async (req, res) => {
  try {
    const { key } = req.params;
    const updates = req.body;
    const organizationId = req.user?.organization_id;

    const updatedStage = await LeadStage.updateLeadStage(key, updates, organizationId);
    if (!updatedStage) {
      return res.status(404).json({ error: 'Stage not found' });
    }

    res.json(updatedStage);
  } catch (err) {
    res.status(500).json({ error: 'Failed to update stage', details: err.message });
  }
});

// Delete stage
router.delete('/stages/:key', jwtAuth, async (req, res) => {
  try {
    const { key } = req.params;
    console.log('[DELETE /stages/:key] Request to delete stage:', key);
    console.log('[DELETE /stages/:key] User:', req.user?.userId);

    // Check if any leads are using this stage
    const leadsInStage = await Lead.getLeadsInStage(key);
    console.log('[DELETE /stages/:key] Leads in stage:', leadsInStage?.length || 0);
    
    if (leadsInStage && leadsInStage.length > 0) {
      console.log('[DELETE /stages/:key] Cannot delete - stage has leads');
      return res.status(400).json({ 
        error: 'Cannot delete stage with existing leads',
        leadsCount: leadsInStage.length
      });
    }

    console.log('[DELETE /stages/:key] Calling deleteLeadStage...');
    const deleted = await LeadStage.deleteLeadStage(key);
    console.log('[DELETE /stages/:key] deleteLeadStage result:', deleted);
    
    if (!deleted) {
      console.log('[DELETE /stages/:key] Stage not found');
      return res.status(404).json({ error: 'Stage not found' });
    }

    console.log('[DELETE /stages/:key] Stage deleted successfully');
    res.json({ message: 'Stage deleted successfully' });
  } catch (err) {
    console.error('[DELETE /stages/:key] Error:', err);
    res.status(500).json({ error: 'Failed to delete stage', details: err.message });
  }
});

// Reorder stages
router.put('/stages/reorder', jwtAuth, async (req, res) => {
  try {
    const { stageOrders } = req.body;
    
    if (!Array.isArray(stageOrders)) {
      return res.status(400).json({ error: 'stageOrders must be an array' });
    }

    await LeadStage.reorderStages(stageOrders);
    res.json({ message: 'Stages reordered successfully' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to reorder stages', details: err.message });
  }
});

