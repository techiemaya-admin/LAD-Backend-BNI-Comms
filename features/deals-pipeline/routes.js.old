// Upload attachment to lead (using same pattern as messages)
const multer = require('multer');
const { Storage } = require('@google-cloud/storage');
const fs = require('fs');
const upload = multer({ dest: 'uploads/' });
const storage = new Storage({ keyFilename: process.env.GCP_KEY_PATH });
const bucketName = process.env.GCP_BUCKET_NAME;

router.post('/:id/attachments', jwtAuth, upload.single('file'), async (req, res) => {
  try {
    const leadId = req.params.id;
    const file = req.file;
    
    if (!file) {
      return res.status(400).json({ error: 'No file uploaded' });
    }

    // Upload file to GCP
    const gcsFileName = `lead-attachments/${leadId}/${Date.now()}_${file.originalname}`;
    const bucket = storage.bucket(bucketName);
    await bucket.upload(file.path, {
      destination: gcsFileName,
      resumable: false,
      public: false
    });
    
    // Remove temp file
    fs.unlinkSync(file.path);

    // Get signed URL (valid 7 days)
    const [url] = await bucket.file(gcsFileName).getSignedUrl({
      action: 'read',
      expires: Date.now() + 7 * 24 * 60 * 60 * 1000
    });

    // Store attachment with complete metadata
    const attachmentData = {
      url,
      filename: file.originalname,
      mimetype: file.mimetype,
      size: file.size,
      gcs_path: gcsFileName
    };

    // Get user ID from JWT token
    const userId = req.user?.userId;

    const attachment = await Lead.addLeadAttachment(leadId, attachmentData, userId);
    res.status(201).json(attachment);
  } catch (err) {
    console.error('[LEADS API] Error uploading attachment:', err);
    res.status(500).json({ error: 'Failed to upload attachment', details: err.message });
  }
});

// Delete attachment
router.delete('/:id/attachments/:attachmentId', jwtAuth, async (req, res) => {
  try {
    await Lead.deleteLeadAttachment(req.params.attachmentId);
    res.json({ message: 'Attachment deleted successfully' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete attachment', details: err.message });
  }
});



